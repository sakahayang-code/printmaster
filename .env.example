# PRINTMASTER - Environment Variables
# Salin berkas ini menjadi .env dan sesuaikan kredensial Anda.
# Berkas .env tidak akan pernah terhapus atau ditimpa saat update aplikasi.

APP_NAME=PRINTMASTER
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=printmaster
DB_USER=root
DB_PASS=

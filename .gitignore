# Environment & Database Binaries
.mariadb_bin/
.mariadb_data/
.gemini
.local/
sakahayang-code/
bin/
upload/
PrintMaster_Blueprint_Teknis_Lengkap.docx

# Linux System Files
.bash_logout
.bashrc
.profile
.gitconfig

# Storage & Temp
storage/logs/*
!storage/logs/.gitkeep
storage/cache/*
!storage/cache/.gitkeep

# Uploads
public/uploads/*
!public/uploads/.gitkeep

# Environment & Local Configuration Overrides
.env
config/database.local.php

# Backups (SQL dumps)
storage/backups/*
!storage/backups/.gitkeep

# SQLite Database & WAL Journals (Preserves production data across git pulls/code modifications)
database/*.sqlite
database/*.sqlite-journal
database/*.sqlite-wal
database/*.sqlite-shm
!database/printmaster.sqlite.example
